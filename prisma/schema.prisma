// Schema do banco de dados — Twins Artigos Personalizados
// Postgres (Vercel Postgres / Neon). Rodar `npm run prisma:migrate` localmente
// (com DATABASE_URL configurado) para gerar a primeira migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catálogo local, sincronizado periodicamente da API da XBZ.
// O site NUNCA lê a XBZ direto — sempre lê daqui.
model Product {
  id             Int      @id @default(autoincrement())

  // Dados vindos da XBZ (ver XBZ_API__GuiaIntegracao__V001.pdf, endpoint /ProdutosListar)
  xbzId          Int      @unique // "id" retornado pela XBZ
  codigoXbz      String   @unique // SKU, usado depois para gerar pedido/orçamento
  codigoComposto String? // código com indicação de cor
  codigoAmigavel String? // código da família de produtos
  nome           String? // título curto (ex: "CANECA ACRÍLICA 400 ML COM TAMPA") — não documentado no PDF, mas presente na resposta real
  descricao      String
  siteLink       String?
  imageLink      String?
  xbzCadastroData DateTime?

  // Dados calculados por nós (a XBZ não retorna preço nem categoria)
  categoria      String   @default("Outros") // classificado por palavra-chave, ver src/lib/categorize.ts
  ativo          Boolean  @default(true) // false = sumiu da última sincronização (não deletamos, só ocultamos)

  // Ajustes manuais feitos no painel de administração (/admin) — têm
  // prioridade sobre os dados/classificação automática da sincronização.
  categoriaManual   String? // se definido, sobrescreve `categoria` na exibição
  ocultoManualmente Boolean @default(false) // ex: indisponível, mas a XBZ ainda lista
  destaque          Boolean @default(false)
  maisVendido       Boolean @default(false)

  syncedAt       DateTime @default(now()) // última vez que foi visto na XBZ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quoteItems     QuoteRequestItem[]
  campanhas      CampanhaSazonal[] // 0 ou mais campanhas (ex: um produto pode estar em "Verão" e "Outubro Rosa" ao mesmo tempo)

  @@index([categoria])
  @@index([ativo])
  @@index([destaque])
  @@index([maisVendido])
}

// Categorias do catálogo, gerenciadas em /admin/categorias — criar, renomear
// e excluir. A classificação automática por palavra-chave na sincronização
// (src/lib/categorize.ts) continua sugerindo uma categoria pra cada produto
// novo, mas a lista de categorias "válidas" pra escolher/filtrar vem daqui,
// não mais fixa no código.
model Category {
  id        Int      @id @default(autoincrement())

  nome      String   @unique
  ordem     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ordem])
}

// Campanhas sazonais/temáticas (ex: "☀️ Verão", "🎗️ Outubro Rosa") — aparecem
// como chips extras na barra principal do catálogo, ao lado de Destaques/Mais
// vendidos, só quando `ativa = true`. Um produto pode estar em 0 ou mais
// campanhas ao mesmo tempo. Curadoria 100% manual por enquanto (via Prisma
// Studio — sem UI própria no /admin ainda).
model CampanhaSazonal {
  id        Int      @id @default(autoincrement())

  nome      String   @unique
  icone     String // emoji, ex: "☀️"
  ativa     Boolean  @default(false)

  produtos  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativa])
}

// Banner do topo do catálogo — gerenciado em /admin/banners. É imagem pura
// (o texto já vem embutido na própria arte, produzida pela Twins) — sem
// título/descrição renderizados em HTML. Proporção de referência 1920x600.
// Suporta mais de um banner ativo ao mesmo tempo (empilhados, por `ordem`),
// mas o uso típico é 1 só — trocar campanha sazonal é só desativar o antigo
// e ativar o novo, sem mexer em código.
model Banner {
  id        Int      @id @default(autoincrement())

  imagem    String // URL da imagem (mesmo CDN das fotos de produto)
  href      String? // link opcional ao clicar (ex: /catalogo?categoria=Verão)
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo, ordem])
}

// Configuração global de tema do site — não é preferência por visitante
// (tipo dark mode individual), é uma configuração de marca única aplicada a
// todos os visitantes até ser trocada. Singleton: sempre a linha id=1,
// editada via Prisma Studio (sem UI própria no /admin ainda). Ver
// src/lib/tema.ts.
model SiteConfig {
  id       Int    @id @default(1)

  temaSite String @default("escuro") // "claro" | "escuro" | "hibrido"

  updatedAt DateTime @updatedAt
}

// Pedido de orçamento feito por um visitante do site (não é o pedido real na XBZ —
// é um lead que o time da Twins confirma manualmente, por WhatsApp/telefone).
model QuoteRequest {
  id           Int      @id @default(autoincrement())

  empresa      String
  contatoNome  String
  contatoFone  String
  contatoEmail String?
  observacoes  String?

  status       String   @default("novo") // novo | em_andamento | respondido | encerrado

  createdAt    DateTime @default(now())

  items        QuoteRequestItem[]
}

model QuoteRequestItem {
  id             Int          @id @default(autoincrement())

  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  quoteRequestId Int

  product        Product      @relation(fields: [productId], references: [id])
  productId      Int

  quantidade     Int
}

// Histórico de execuções da sincronização com a XBZ — útil pra auditar
// quantas chamadas foram feitas (respeitar limite de 24/dia, compartilhado com o ERP).
model SyncLog {
  id            Int       @id @default(autoincrement())

  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String // running | success | error
  totalFetched  Int?
  totalCreated  Int?
  totalUpdated  Int?
  totalDeactivated Int?
  errorMessage  String?
}
