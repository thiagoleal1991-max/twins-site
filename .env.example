# Copie este arquivo para .env (local) e preencha os valores reais.
# .env NUNCA deve ser commitado (já está no .gitignore).

# Banco de dados Postgres (Vercel Postgres / Neon). Na Vercel, ao criar o
# banco pelo dashboard, essa variável é preenchida automaticamente.
DATABASE_URL=

# Credenciais da API XBZ Brindes (ver XBZ_API__GuiaIntegracao__V001.pdf)
XBZ_CNPJ=
XBZ_TOKEN=
XBZ_BASE_URL=https://api.minhaxbz.com.br:5001/api/clientes

# Segredo para autenticar chamadas à rota de sincronização (/api/sync/xbz).
# Gere uma string aleatória qualquer (ex: openssl rand -hex 32) e configure
# a MESMA variável CRON_SECRET no projeto da Vercel — o Vercel Cron já envia
# esse valor automaticamente no header Authorization.
CRON_SECRET=
